# KIKFIA live site: one address, compression, browser caching, two safe headers, and no private files.
# Hostinger's own HTTPS redirect handles http to https.

# one address: www.kikfia.com moves to kikfia.com (Hostinger already moves http to https)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.kikfia\.com$ [NC]
  RewriteRule ^(.*)$ https://kikfia.com/$1 [R=301,L]
</IfModule>

# deployment leftovers (the Git checkout and its archive folder) are never served
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(release|deploy)(/|$)
  RedirectMatch 404 /\.git(/|$)
</IfModule>

# lead logs and settings live outside the web root; if one is ever copied here, it is still never served
<FilesMatch "\.(csv|ini|log)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 7 days"
  ExpiresByType video/mp4 "access plus 7 days"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  # short, so a new ID in kikfia-config.js reaches visitors within the hour
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
